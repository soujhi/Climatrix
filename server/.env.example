# Server Configuration (Node + Express)
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Replace with your MongoDB connection string (e.g., MongoDB Atlas URI or local instance mongodb://localhost:27017/climatrix)
MONGODB_URI=mongodb://localhost:27017/climatrix

# Google Authentication Credentials
# Obtain Google Client ID from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# JWT Secret Token for Authenticated Sessions
JWT_SECRET=climatrix_jwt_secret_key_change_in_production_2026

# Frontend Client URL for CORS Security
CLIENT_URL=http://localhost:5173
